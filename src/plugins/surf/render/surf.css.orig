/* Surf Dashboard - E-Ink Optimized v2 */
/* Clean, high-contrast, large readable text */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.surf-dashboard {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 100%;
  font-family: "Jost", "Helvetica Neue", Arial, sans-serif;
  padding: 2dvh 3dvw;
  gap: 1.5dvh;
  position: relative;
  background: white;
}

/* ============ HEADER ============ */
.header {
  width: 100%;
  text-align: center;
  padding-bottom: 1dvh;
  border-bottom: 3px solid black;
}

.title {
  font-size: min(6dvh, 8dvw);
  font-weight: 700;
  line-height: 1.1;
  color: black;
  letter-spacing: -0.02em;
}

.current-date {
  font-size: min(3dvh, 4.5dvw);
  color: black;
  margin-top: 0.5dvh;
  font-weight: 500;
}

.last-refresh {
  position: absolute;
  top: 1dvh;
  right: 2dvw;
  font-size: min(2dvh, 2.5dvw);
  color: black;
  font-weight: 600;
}

/* ============ MAIN CONTAINER ============ */
.main-container {
  display: flex;
  flex-direction: row;
  width: 100%;
  flex: 1;
  gap: 3dvw;
  min-height: 0;
}

/* ============ LEFT SIDE - CURRENT CONDITIONS ============ */
.current-conditions {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 42%;
  gap: 2dvh;
}

/* Wave Height Display */
.wave-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.wave-icon-container {
  width: 60px;
  height: 60px;
  margin-bottom: 0.5dvh;
}

.wave-svg {
  width: 100%;
  height: 100%;
  color: black;
}

.wave-icon {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.wave-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.wave-height {
  font-size: min(16dvh, 22dvw);
  font-weight: 700;
  line-height: 0.9;
  color: black;
  letter-spacing: -0.03em;
}

.height-unit {
  font-size: 0.3em;
  font-weight: 600;
  vertical-align: super;
  margin-left: 0.05em;
}

.size-rating {
  font-size: min(4dvh, 6dvw);
  color: black;
  font-weight: 600;
  margin-top: 0.5dvh;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.quality-badge {
  display: inline-block;
  padding: 0.5dvh 2dvw;
  font-size: min(2.5dvh, 3.5dvw);
  font-weight: 700;
  margin-top: 1dvh;
  border: 3px solid black;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.quality-epic {
  background: black;
  color: white;
}

.quality-good {
  background: white;
  color: black;
}

.quality-fair {
  background: white;
  color: black;
}

.quality-poor {
  background: white;
  color: black;
}

.quality-flat {
  background: white;
  color: black;
  border-style: dashed;
}

/* ============ COMPASS ============ */
.compass-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.8dvh;
}

.compass {
  position: relative;
  width: min(16dvh, 22dvw);
  height: min(16dvh, 22dvw);
  border: 4px solid black;
  border-radius: 50%;
  background: white;
}

.compass-ring {
  position: absolute;
  width: 100%;
  height: 100%;
}

.compass-label {
  position: absolute;
  font-size: min(2.2dvh, 3dvw);
  font-weight: 700;
  color: black;
}

.compass-label.north {
  top: 6%;
  left: 50%;
  transform: translateX(-50%);
}

.compass-label.south {
  bottom: 6%;
  left: 50%;
  transform: translateX(-50%);
}

.compass-label.east {
  right: 6%;
  top: 50%;
  transform: translateY(-50%);
}

.compass-label.west {
  left: 6%;
  top: 50%;
  transform: translateY(-50%);
}

.compass-arrow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6px;
  height: 65%;
  transform-origin: center center;
  margin-left: -3px;
  margin-top: -32.5%;
}

.arrow-head {
  width: 0;
  height: 0;
  border-left: 12px solid transparent;
  border-right: 12px solid transparent;
  border-bottom: 28px solid black;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.arrow-tail {
  width: 6px;
  height: calc(100% - 28px);
  background: linear-gradient(to bottom, black 0%, black 45%, #888 45%, #888 100%);
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}

.compass-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: white;
  padding: 0.8dvh 1.5dvw;
  border-radius: 50%;
  font-size: min(2.8dvh, 4dvw);
  font-weight: 700;
  color: black;
  z-index: 10;
  border: 3px solid black;
  min-width: 3em;
  text-align: center;
}

.compass-label-below {
  font-size: min(2dvh, 3dvw);
  color: black;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* ============ RIGHT SIDE - DATA POINTS ============ */
.data-points {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5dvh 2dvw;
  width: 58%;
  align-content: center;
}

.data-point {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 1.5dvw;
  padding: 1.2dvh 1.5dvw;
  background: white;
  border: 2px solid black;
}

.data-point-icon-container {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.data-point-icon {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.icon-fallback {
  font-size: 32px;
  text-align: center;
  line-height: 48px;
  color: black;
}

.data-point-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.data-point-label {
  font-size: min(2dvh, 2.8dvw);
  color: black;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.data-point-value {
  font-size: min(4dvh, 5.5dvw);
  font-weight: 700;
  color: black;
  line-height: 1.1;
  white-space: nowrap;
}

.data-point-unit {
  font-size: 0.55em;
  font-weight: 600;
  margin-left: 0.15em;
}

.direction-arrow {
  font-size: 0.85em;
  margin-left: 0.2em;
}

.moon-phase-point {
  /* Same styling as other data points */
}

.moon-icon {
  /* No grayscale filter - keep it crisp */
}

/* ============ CHART SECTION ============ */
.chart-section {
  width: 100%;
  padding-top: 1dvh;
  border-top: 2px solid black;
}

.chart-title {
  font-size: min(2.5dvh, 3.5dvw);
  font-weight: 700;
  text-align: center;
  margin-bottom: 0.8dvh;
  color: black;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.trend-indicator {
  font-size: 1.3em;
  margin-left: 0.5em;
  font-weight: 700;
}

.trend-rising {
  /* Keep black for e-ink */
}

.trend-falling {
  /* Keep black for e-ink */
}

.trend-steady {
  /* Keep black for e-ink */
}

.chart-container {
  width: 100%;
  height: 14dvh;
}

/* ============ FOOTER ============ */
.footer {
  width: 100%;
  display: flex;
  justify-content: space-between;
  font-size: min(1.8dvh, 2.5dvw);
  color: black;
  padding-top: 0.8dvh;
  border-top: 2px solid black;
  font-weight: 500;
}

.station-info {
  font-weight: 600;
}

.reading-time {
  font-weight: 500;
}

/* ============ RESPONSIVE - PORTRAIT MODE ============ */
@media (max-aspect-ratio: 1) {
  .main-container {
    flex-direction: column;
    gap: 2dvh;
  }
  
  .current-conditions {
    flex-direction: row;
    width: 100%;
    justify-content: space-around;
    gap: 3dvw;
  }
  
  .wave-display {
    width: auto;
  }
  
  .wave-height {
    font-size: min(12dvh, 25dvw);
  }
  
  .data-points {
    width: 100%;
    grid-template-columns: repeat(3, 1fr);
  }
  
  .compass {
    width: min(14dvh, 28dvw);
    height: min(14dvh, 28dvw);
  }
  
  .data-point-icon-container {
    width: 40px;
    height: 40px;
  }
  
  .data-point-value {
    font-size: min(3.5dvh, 5dvw);
  }
}

/* Very tall screens */
@media (max-aspect-ratio: 1/2) {
  .data-points {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .current-conditions {
    flex-direction: column;
  }
}

/* Wide screens */
@media (min-aspect-ratio: 2) {
  .data-points {
    grid-template-columns: repeat(3, 1fr);
  }
  
  .compass {
    width: min(18dvh, 14dvw);
    height: min(18dvh, 14dvw);
  }
  
  .data-point-icon-container {
    width: 56px;
    height: 56px;
  }
}

/* Small displays - use pixel font */
@media (max-width: 300px) {
  .surf-dashboard {
    font-family: "Dogica", monospace;
  }
  
  .data-points {
    grid-template-columns: 1fr;
  }
  
  .data-point-icon-container {
    width: 32px;
    height: 32px;
  }
}
